<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- VUES : IMAGES DE CATÉGORIE                   -->
    <!-- ============================================ -->

    <!-- Vue Kanban pour les images -->
    <record id="view_hotel_room_category_image_kanban" model="ir.ui.view">
        <field name="name">hotel.room.category.image.kanban</field>
        <field name="model">hotel.room.category.image</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="image"/>
                <field name="sequence"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('hotel.room.category.image', 'image', record.id.raw_value)"
                                     alt="Image" class="o_image_64_cover"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    Séquence: <field name="sequence"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue Formulaire pour les images -->
    <record id="view_hotel_room_category_image_form" model="ir.ui.view">
        <field name="name">hotel.room.category.image.form</field>
        <field name="model">hotel.room.category.image</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="name" placeholder="Ex: Vue de face, Intérieur salon..."/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="category_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue List pour les images -->
    <record id="view_hotel_room_category_image_list" model="ir.ui.view">
        <field name="name">hotel.room.category.image.list</field>
        <field name="model">hotel.room.category.image</field>
        <field name="arch" type="xml">
            <list string="Images" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [50, 50]}"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- ============================================ -->
    <!-- VUES : CATÉGORIES (CORRIGÉES)                -->
    <!-- ============================================ -->

    <!-- Vue List des catégories -->
    <record id="view_hotel_room_category_list" model="ir.ui.view">
        <field name="name">hotel.room.category.list</field>
        <field name="model">hotel.room.category</field>
        <field name="arch" type="xml">
            <list string="Catégories d'Appartements">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="bedroom_count"/>
                <field name="is_furnished"/>
                <field name="image_count"/>
                <field name="total_rooms"/>
                <field name="available_rooms"/>
                <field name="availability_rate" widget="progressbar"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vue Kanban des catégories -->
    <record id="view_hotel_room_category_kanban" model="ir.ui.view">
        <field name="name">hotel.room.category.kanban</field>
        <field name="model">hotel.room.category</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="image"/>
                <field name="bedroom_count"/>
                <field name="is_furnished"/>
                <field name="total_rooms"/>
                <field name="available_rooms"/>
                <field name="image_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('hotel.room.category', 'image', record.id.raw_value)"
                                     alt="Image"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <i class="fa fa-bed"/> <field name="bedroom_count"/> Chambres
                                    <t t-if="record.is_furnished.raw_value">
                                        | <i class="fa fa-check text-success"/> Meublé
                                    </t>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="badge badge-pill badge-info">
                                            <i class="fa fa-images"/> <field name="image_count"/> photos
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span class="badge badge-pill badge-success">
                                            <field name="available_rooms"/>/<field name="total_rooms"/> dispo
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue Form des catégories avec SÉLECTION d'appartements -->
    <record id="view_hotel_room_category_form" model="ir.ui.view">
        <field name="name">hotel.room.category.form</field>
        <field name="model">hotel.room.category</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_view_rooms"
                            type="object"
                            string="Voir les Appartements"
                            class="btn-primary"
                            invisible="total_rooms == 0"/>
                    <button name="action_view_gallery"
                            type="object"
                            string="Galerie d'Images"
                            class="btn-secondary"
                            invisible="image_count == 0"/>
                </header>
                <sheet>
                    <!-- Image principale (fallback) -->
                    <field name="image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image'}"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Ex: Appartements Meublés 2 Chambres"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Informations Générales">
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="bedroom_count"/>
                            <field name="is_furnished"/>
                        </group>
                        <group string="Statistiques">
                            <field name="total_rooms"/>
                            <field name="available_rooms"/>
                            <field name="occupied_rooms"/>
                            <field name="availability_rate" widget="progressbar"/>
                            <field name="image_count"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- ONGLET 1 : Galerie d'images -->
                        <page string="Galerie d'Images" name="image_gallery">
                            <field name="image_ids" mode="kanban">
                                <kanban>
                                    <field name="id"/>
                                    <field name="name"/>
                                    <field name="image"/>
                                    <field name="sequence"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                                                <div class="o_kanban_image">
                                                    <img t-att-src="kanban_image('hotel.room.category.image', 'image', record.id.raw_value)"
                                                         alt="Image" style="max-height: 200px;"/>
                                                </div>
                                                <div class="oe_kanban_details">
                                                    <strong><field name="name"/></strong>
                                                    <div>Ordre: <field name="sequence"/></div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                                <form>
                                    <sheet>
                                        <field name="image" widget="image" class="oe_avatar"/>
                                        <group>
                                            <field name="name" placeholder="Ex: Vue salon, Chambre principale..."/>
                                            <field name="sequence"/>
                                            <field name="active"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                            <div class="alert alert-info" role="alert" invisible="image_count &gt; 0">
                                <strong>Astuce :</strong> Cliquez sur "Ajouter" pour uploader plusieurs images.
                                Les images seront affichées dans un carousel sur le site web.
                            </div>
                        </page>

                        <!-- ONGLET 2 : Description -->
                        <page string="Description" name="description">
                            <field name="description" placeholder="Décrivez les caractéristiques de cette catégorie..."/>
                        </page>

                        <!-- ONGLET 3 : Appartements (CORRIGÉ avec sélection) -->
                        <page string="Appartements" name="rooms">
                            <!-- ═══════════════════════════════════════════════════════ -->
                            <!-- SECTION DE SÉLECTION (Many2many widget tags)            -->
                            <!-- ═══════════════════════════════════════════════════════ -->
                            <group string="🔍 Sélectionner des Appartements">
                                <field name="selected_room_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True, 'no_create_edit': True, 'color_field': 'color'}"
                                       placeholder="Cliquez pour sélectionner des appartements du module hotel_management_system..."
                                       help="Sélectionnez les appartements à assigner à cette catégorie. Seuls les appartements non assignés et ceux déjà dans cette catégorie sont affichés."/>
                            </group>

                            <div class="alert alert-success" role="alert" invisible="total_rooms == 0" style="margin: 15px 0;">
                                <i class="fa fa-check-circle"/> <strong>Appartements assignés :</strong> <field name="total_rooms"/> appartement(s)
                            </div>

                            <div class="alert alert-info" role="alert" invisible="total_rooms &gt; 0" style="margin: 15px 0;">
                                <i class="fa fa-info-circle"/> <strong>Aucun appartement assigné.</strong> Utilisez le champ ci-dessus pour sélectionner des appartements existants depuis le module <code>hotel_management_system</code>.
                            </div>

                            <!-- ═══════════════════════════════════════════════════════ -->
                            <!-- LISTE DES APPARTEMENTS ASSIGNÉS (One2many lecture seule) -->
                            <!-- ═══════════════════════════════════════════════════════ -->
                            <separator string="📋 Liste des Appartements Assignés" invisible="total_rooms == 0"/>
                            <field name="room_ids"
                                   nolabel="1"
                                   invisible="total_rooms == 0"
                                   context="{'default_is_room_type': True}">
                                <list string="Appartements"
                                      create="false"
                                      delete="false"
                                      editable="bottom">
                                    <field name="name" readonly="1"/>
                                    <field name="default_code" readonly="1"/>
                                    <field name="bedroom_count" readonly="1" optional="show"/>
                                    <field name="is_furnished" readonly="1" optional="show"/>
                                    <field name="list_price" widget="monetary" readonly="1"/>
                                    <field name="is_available_today" readonly="1" optional="show" widget="boolean"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action pour les catégories -->
    <record id="action_hotel_room_category" model="ir.actions.act_window">
        <field name="name">Catégories d'Appartements</field>
        <field name="res_model">hotel.room.category</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première catégorie d'appartements
            </p>
            <p>
                Les catégories permettent de regrouper vos appartements par type
                (meublé/non-meublé, nombre de chambres, etc.)
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_hotel_residence_category_root"
              name="Résidence Hôtelière"
              web_icon="hotel_residence_category,static/description/icon.png"
              sequence="50"/>

    <menuitem id="menu_hotel_room_category"
              name="Catégories d'appartements"
              parent="hotel_management_system.menu_hotel_configuration"
              action="action_hotel_room_category"
              sequence="15"
              groups="hotel_management_system.hotel_owner_group,hotel_management_system.hotel_reception_group"/>

</odoo>