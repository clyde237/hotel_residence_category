<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========== PAS DE VUE HÉRITÉE - CONFIGURATION MANUELLE ========== -->
    <!-- Les champs bedroom_count et is_furnished existent déjà sur product.product -->
    <!-- Ils seront visibles en mode développeur -->

    <!-- Vue Liste des produits (pour utilisation dans room_ids) -->
    <record id="view_product_product_tree_room_category" model="ir.ui.view">
        <field name="name">product.product.tree.room.category</field>
        <field name="model">product.product</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Appartements">
                <field name="name"/>
                <field name="bedroom_count" optional="show"/>
                <field name="is_furnished" widget="boolean_toggle" optional="show"/>
                <field name="list_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="max_adult" optional="show"/>
                <field name="max_child" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Vue Liste (List - Odoo 18) -->
    <record id="view_hotel_room_category_tree" model="ir.ui.view">
        <field name="name">hotel.room.category.list</field>
        <field name="model">hotel.room.category</field>
        <field name="arch" type="xml">
            <list string="Catégories d'appartements">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="bedroom_count"/>
                <field name="is_furnished" widget="boolean_toggle"/>
                <field name="total_rooms"/>
                <field name="available_rooms"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vue Formulaire -->
    <record id="view_hotel_room_category_form" model="ir.ui.view">
        <field name="name">hotel.room.category.form</field>
        <field name="model">hotel.room.category</field>
        <field name="arch" type="xml">
            <form string="Catégorie d'appartement">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Bouton pour voir les appartements de cette catégorie -->
                        <button name="action_view_rooms" type="object" class="oe_stat_button" icon="fa-building">
                            <field name="total_rooms" widget="statinfo" string="Appartements"/>
                        </button>
                    </div>

                    <field name="image" widget="image" class="oe_avatar"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Ex: Appartements meublés 3 chambres"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="bedroom_count"/>
                            <field name="is_furnished"/>
                        </group>
                        <group>
                            <field name="total_rooms" readonly="1"/>
                            <field name="available_rooms" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Description de la catégorie pour le site web..."/>
                        </page>
                        <page string="Appartements" name="rooms">
                            <!-- Sélection rapide en tags -->
                            <group string="Ajouter des appartements">
                                <field name="room_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True, 'no_quick_create': True}"
                                       domain="[('is_room_type', '=', True)]"
                                       placeholder="Cliquez pour sélectionner des appartements..."
                                       nolabel="1"/>
                            </group>

                            <!-- Message d'information SANS directives OWL -->
                            <div class="alert alert-warning mt-2" role="alert">
                                <i class="fa fa-info-circle"/>
                                <strong>Astuce :</strong> Pour une meilleure organisation, sélectionnez de préférence les appartements correspondant aux critères de cette catégorie.
                            </div>

                            <!-- Vue détaillée des appartements sélectionnés -->
                            <separator string="Appartements dans cette catégorie" invisible="not room_ids"/>
                            <field name="room_ids"
                                   nolabel="1"
                                   invisible="not room_ids">
                                <list create="false" delete="true" edit="false" string="Détails">
                                    <field name="name"/>
                                    <field name="bedroom_count" optional="show"/>
                                    <field name="is_furnished" widget="boolean_toggle" optional="show"/>
                                    <field name="list_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="max_adult" optional="show"/>
                                    <field name="max_child" optional="show"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>

                            <!-- Message d'aide -->
                            <div class="alert alert-info mt-3" role="alert" invisible="room_ids">
                                <i class="fa fa-lightbulb-o"/>
                                <strong>Aucun appartement dans cette catégorie.</strong>
                                <p class="mb-0">
                                    Utilisez le champ ci-dessus pour sélectionner des appartements existants.
                                </p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue Kanban -->
    <record id="view_hotel_room_category_kanban" model="ir.ui.view">
        <field name="name">hotel.room.category.kanban</field>
        <field name="model">hotel.room.category</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="bedroom_count"/>
                <field name="is_furnished"/>
                <field name="total_rooms"/>
                <field name="available_rooms"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column">
                            <div class="d-flex flex-row gap-2">
                                <!-- Image avec fallback -->
                                <div class="o_kanban_image position-relative">
                                    <t t-if="record.image.raw_value">
                                        <img t-att-src="'/web/image/hotel.room.category/' + record.id.raw_value + '/image/90x90'"
                                             alt="Category"
                                             class="o_image_64_cover rounded"
                                             style="width: 64px; height: 64px; object-fit: cover;"/>
                                    </t>
                                    <t t-else="">
                                        <div class="bg-secondary d-flex align-items-center justify-content-center rounded"
                                             style="width: 64px; height: 64px;">
                                            <i class="fa fa-building fa-2x text-white"/>
                                        </div>
                                    </t>
                                </div>

                                <!-- Contenu -->
                                <div class="d-flex flex-column gap-1 flex-grow-1">
                                    <div class="d-flex flex-row justify-content-between">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_subtitle text-muted small">
                                        <i class="fa fa-bed"/> <field name="bedroom_count"/> chambre(s) -
                                        <t t-if="record.is_furnished.raw_value">
                                            <i class="fa fa-check text-success"/> Meublé
                                        </t>
                                        <t t-else="">
                                            <i class="fa fa-cube text-info"/> Non-meublé
                                        </t>
                                    </div>
                                    <div class="o_kanban_record_bottom mt-2">
                                        <span class="badge rounded-pill text-bg-success me-1">
                                            <field name="available_rooms"/> disp.
                                        </span>
                                        <span class="badge rounded-pill text-bg-info">
                                            <field name="total_rooms"/> total
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue Recherche -->
    <record id="view_hotel_room_category_search" model="ir.ui.view">
        <field name="name">hotel.room.category.search</field>
        <field name="model">hotel.room.category</field>
        <field name="arch" type="xml">
            <search string="Rechercher catégories">
                <field name="name"/>
                <field name="code"/>
                <filter string="2 Chambres" name="filter_2bed" domain="[('bedroom_count', '=', '2')]"/>
                <filter string="3 Chambres" name="filter_3bed" domain="[('bedroom_count', '=', '3')]"/>
                <separator/>
                <filter string="Meublés" name="filter_furnished" domain="[('is_furnished', '=', True)]"/>
                <filter string="Non-meublés" name="filter_unfurnished" domain="[('is_furnished', '=', False)]"/>
                <separator/>
                <filter string="Actif" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Inactif" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Grouper par">
                    <filter string="Nombre de chambres" name="group_bedroom" context="{'group_by': 'bedroom_count'}"/>
                    <filter string="Type" name="group_furnished" context="{'group_by': 'is_furnished'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action de menu -->
    <record id="action_hotel_room_category" model="ir.actions.act_window">
        <field name="name">Catégories d'appartements</field>
        <field name="res_model">hotel.room.category</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créer une nouvelle catégorie d'appartement
            </p>
            <p>
                Les catégories permettent de regrouper vos appartements par type (meublé/non-meublé) et nombre de chambres.
            </p>
        </field>
    </record>

    <!-- Menu dans Hotel Management -->
    <menuitem id="menu_hotel_room_category"
              name="Catégories d'appartements"
              parent="hotel_management_system.menu_hotel_configuration"
              action="action_hotel_room_category"
              sequence="15"
              groups="hotel_management_system.hotel_owner_group,hotel_management_system.hotel_reception_group"/>

</odoo>