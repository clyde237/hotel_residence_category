<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Catégorie 1: Appartements meublés 2 chambres -->
        <record id="category_furnished_2bed" model="hotel.room.category">
            <field name="name">Appartements meublés 2 chambres</field>
            <field name="code">FURN_2BED</field>
            <field name="sequence">10</field>
            <field name="bedroom_count">2</field>
            <field name="is_furnished" eval="True"/>
            <field name="description">Appartements entièrement meublés avec 2 chambres, équipés pour un séjour confortable.</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Catégorie 2: Appartements non-meublés 2 chambres -->
        <record id="category_unfurnished_2bed" model="hotel.room.category">
            <field name="name">Appartements non-meublés 2 chambres</field>
            <field name="code">UNFURN_2BED</field>
            <field name="sequence">20</field>
            <field name="bedroom_count">2</field>
            <field name="is_furnished" eval="False"/>
            <field name="description">Appartements non-meublés avec 2 chambres, idéaux pour un aménagement personnalisé.</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Catégorie 3: Appartements meublés 3 chambres -->
        <record id="category_furnished_3bed" model="hotel.room.category">
            <field name="name">Appartements meublés 3 chambres</field>
            <field name="code">FURN_3BED</field>
            <field name="sequence">30</field>
            <field name="bedroom_count">3</field>
            <field name="is_furnished" eval="True"/>
            <field name="description">Appartements spacieux entièrement meublés avec 3 chambres.</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Catégorie 4: Appartements non-meublés 3 chambres -->
        <record id="category_unfurnished_3bed" model="hotel.room.category">
            <field name="name">Appartements non-meublés 3 chambres</field>
            <field name="code">UNFURN_3BED</field>
            <field name="sequence">40</field>
            <field name="bedroom_count">3</field>
            <field name="is_furnished" eval="False"/>
            <field name="description">Appartements non-meublés avec 3 chambres, offrant un grand espace de vie.</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>